[databricks]
server_hostname = "dbc-xxxxxxxx-xxxx.cloud.databricks.com"
http_path = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
access_token = "dapi..."

# Required for the "Add a fragrance" tab: workspace path to
# jobs/generate_embeddings_for_new_frag.py (include the .py extension —
# this is a plain script path, not a notebook path). Find it via the
# Databricks workspace file browser (right-click the file -> Copy path, or
# check the URL when it's open).
embedding_job_python_file = "/Workspace/Repos/<you>/sniffers/jobs/generate_embeddings_for_new_frag.py"

# Optional: only needed if your workspace doesn't have serverless job
# compute enabled. If set, the embedding job runs on this existing
# all-purpose cluster instead of serverless. Leave unset to try serverless.
# job_cluster_id = "0000-000000-abcdefgh"
