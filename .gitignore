# Ignore generated data and output files
*.json
*.csv
*.parquet

# Scraper test fixtures (large raw HTML snapshots)
scraping/fixtures/*.html

# Legacy/archived files kept locally for reference, not tracked in git
legacy/

# Python virtual environments
venv/
.DS_Store

# Python bytecode cache — Databricks Workspace/Git folders won't allow
# pulling a __pycache__ directory, so this must never be committed
__pycache__/
*.pyc

.databricks

# Streamlit app secrets (Databricks connection details + token)
streamlit_app/.streamlit/secrets.toml
